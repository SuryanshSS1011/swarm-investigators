# Copy to compute.env (gitignored) and fill in only what you need. Every command reads it from the repo root,
# and variables already set in your shell take precedence.

# Anthropic API, for model ids that start with "claude/".
ANTHROPIC_API_KEY=
# Only for personal keys that are not scoped to a workspace (the API returns a 400 asking for it).
# Find the id at platform.claude.com/settings/workspaces.
ANTHROPIC_WORKSPACE_ID=

# Google's OpenAI-compatible Gemini endpoint, for "gemini/<id>".
GEMINI_API_KEY=

# OpenAI, for "openai/<id>". Run these from the laptop, because the cloud workspace cannot reach api.openai.com.
OPENAI_API_KEY=

# OpenRouter, for "openrouter/<id>". Run these from the laptop.
OPENROUTER_API_KEY=

# vLLM servers on Modal (docs/modal_runbook.md), for "vllm/qwen" and "vllm/gptoss". Run these from the laptop.
# Each base URL is the Modal URL with /v1 added.
VLLM_API_KEY=
VLLM_BASE_URL_QWEN=
VLLM_BASE_URL_GPTOSS=

# Spend cap in USD for each output file of swarm.batch and swarm.anthropic_batches. Required when a request file
# has a paid model (claude, gemini, openai, openrouter).
SWARM_BUDGET_USD=
